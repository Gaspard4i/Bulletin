{
  "project": "Bulletin",
  "version": "1.0.0",
  "orchestrator": {
    "name": "orchestrator",
    "description": "Chef d'orchestre - coordonne tous les agents, gère les sprints, résout les dépendances",
    "manages": ["symfony-api", "oauth-security", "database-migration", "testing", "react-architecture", "ui-components", "design-system", "ci-cd", "infrastructure", "dockerization"]
  },
  "agents": {
    "backend": [
      {
        "id": "symfony-api",
        "name": "Symfony API Agent",
        "scope": ["src/Entity", "src/Controller", "src/Service", "src/Repository"],
        "tech": ["symfony-7", "api-platform", "php-8.3", "doctrine-orm"],
        "dependencies": ["database-migration", "oauth-security"]
      },
      {
        "id": "oauth-security",
        "name": "OAuth / Security Agent",
        "scope": ["src/Security", "config/packages/security.yaml"],
        "tech": ["cas-univ-lille", "github-oauth", "jwt", "lexik-jwt"],
        "dependencies": ["symfony-api"]
      },
      {
        "id": "database-migration",
        "name": "Database / Migration Agent",
        "scope": ["migrations", "src/DataFixtures"],
        "tech": ["doctrine-migrations", "postgresql-16"],
        "dependencies": ["dockerization"]
      },
      {
        "id": "testing",
        "name": "Testing Agent",
        "scope": ["tests"],
        "tech": ["phpunit-10", "symfony-test-client"],
        "dependencies": ["symfony-api", "oauth-security", "database-migration"]
      }
    ],
    "frontend": [
      {
        "id": "react-architecture",
        "name": "React Architecture Agent",
        "scope": ["src/routes.tsx", "src/lib", "src/pages"],
        "tech": ["tanstack-router", "tanstack-query", "react-context"],
        "dependencies": ["ui-components"]
      },
      {
        "id": "ui-components",
        "name": "UI Components Agent",
        "scope": ["src/components"],
        "tech": ["shadcn-ui", "tailwindcss", "radix-ui", "lucide-react", "cva"],
        "dependencies": ["design-system"]
      },
      {
        "id": "design-system",
        "name": "Design System Agent",
        "scope": ["tailwind.config.ts", "src/index.css"],
        "tech": ["figma-mcp", "canva-mcp", "design-tokens"],
        "dependencies": []
      }
    ],
    "devops": [
      {
        "id": "ci-cd",
        "name": "CI/CD Agent",
        "scope": [".github/workflows"],
        "tech": ["github-actions", "ghcr"],
        "dependencies": ["dockerization"]
      },
      {
        "id": "infrastructure",
        "name": "Infrastructure Agent",
        "scope": ["infra"],
        "tech": ["cloudflare", "supabase", "vercel", "fly-io"],
        "dependencies": ["dockerization", "ci-cd"]
      },
      {
        "id": "dockerization",
        "name": "Dockerization Agent",
        "scope": ["Dockerfile*", "docker-compose*", "docker/", "Makefile"],
        "tech": ["docker", "docker-compose", "multi-stage-builds", "nginx"],
        "dependencies": []
      }
    ]
  },
  "roles": {
    "hierarchy": ["ROLE_STUDENT", "ROLE_TEACHER", "ROLE_SCOLARITE", "ROLE_ADMIN"],
    "description": {
      "ROLE_STUDENT": "Consulte ses bulletins et notes",
      "ROLE_TEACHER": "Saisit les notes, consulte les bulletins de ses étudiants",
      "ROLE_SCOLARITE": "Valide les bulletins, gère les semestres",
      "ROLE_ADMIN": "Administration complète, gestion des utilisateurs"
    }
  },
  "docker_stack": {
    "services": {
      "symfony-api": { "image": "php:8.3-fpm-alpine", "port": 9000 },
      "react-app": { "image": "node:20-alpine / nginx:alpine", "port": "3000 (dev) / 80 (prod)" },
      "postgresql": { "image": "postgres:16-alpine", "port": 5432 },
      "nginx-proxy": { "image": "nginx:alpine", "port": "80, 443" },
      "redis": { "image": "redis:7-alpine", "port": 6379 },
      "mailpit": { "image": "axllent/mailpit", "port": "1025, 8025", "env": "dev-only" }
    }
  }
}
