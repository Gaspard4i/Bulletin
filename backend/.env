# Symfony environment
APP_ENV=dev
APP_SECRET=change_me_to_a_random_secret_value

# Database - PostgreSQL
DATABASE_URL="postgresql://bulletin:bulletin@127.0.0.1:5432/bulletin?serverVersion=16&charset=utf8"

# JWT Authentication
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your_jwt_passphrase_here

# CORS
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# CAS Authentication - Universite de Lille
CAS_BASE_URL=https://cas.univ-lille.fr/cas

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
