# Symfony Production Environment
# Copy to .env.local on production server and fill in secrets
APP_ENV=prod
APP_SECRET=                     # openssl rand -hex 32

# Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[YOUR_SUPABASE_DB_PASSWORD]@db.omoesegewtfwfvznpwoz.supabase.co:5432/postgres?sslmode=require&charset=utf8"

# JWT Authentication
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=

# CORS - Allow Cloudflare Pages domain
CORS_ALLOW_ORIGIN='^https://bulletin\.pages\.dev$'

# CAS Authentication - Universite de Lille
CAS_BASE_URL=https://cas.univ-lille.fr/cas

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
